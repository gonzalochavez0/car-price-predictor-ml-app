---
import CarApp from "../components/CarApp.jsx";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Predicción de precios de autos usados</title>
    <meta
      name="description"
      content="Demo full-stack que estima el precio de un auto usado con un modelo de machine learning (Random Forest) servido por FastAPI."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="bg-slate-100 min-h-screen flex items-center justify-center p-4">
    <main class="w-full max-w-6xl p-8 bg-white/60 backdrop-blur-lg rounded-3xl shadow-xl">
      <!-- HEADER -->
      <header class="text-center mb-10">
        <div
          class="w-16 h-16 mx-auto rounded-2xl bg-gradient-to-r from-blue-400 to-purple-400 flex items-center justify-center text-white text-2xl"
        >
          <img src="/car.png" alt="" width="40" height="40" />
        </div>

        <h1 class="text-2xl font-semibold mt-4">Predicción de Precios de Autos Usados</h1>

        <p class="text-gray-500 text-sm mt-2">
          Ingresa los datos de tu vehículo para obtener una estimación de precio
        </p>
      </header>

      <CarApp client:load />

      <p class="text-center text-sm text-gray-400 mt-8">
        ✨ Demo de aplicación web — predicción basada en datos simulados
      </p>
    </main>
  </body>
</html>
